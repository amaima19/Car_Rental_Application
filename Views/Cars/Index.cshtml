@model List<Car>

@{
    ViewData["Title"] = "Available Cars";

}
    <h1 class="mb-2">Available Cars</h1>
    <p class="text-muted mb-4">Select a car below to book it.</p>
   
        <div class="col-12 col-md-6 col-lg-4">
            @foreach (var car in Model)
            {
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title mb-3">@car.name</h5>
                    <p class="card-text mb-3">
                    <strong>Daily Price:</strong>
                    PKR @car.price.ToString("N0")
                    </p>

                    <div class="mb-3">
                       
                            Available
             
                    </div>
                    <form action="/Cars/Book" method="post"
                          class="mt-auto">

                        <input type="hidden"
                               name="id"
                               value="@car.id" />

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Book Car
                        </button>
                    </form>

                </div>
            </div>
            }
        </div>